# Every variable is optional; den-edge reads the process environment only (no .env loader).

# Port to listen on (the box publishes it as 8094).
# PORT=8080

# Where the state lives: the library backups, inboxes, plugin lists and settings, one file per key. The image
# sets /data; the box mounts /var/lib/den/edge-data there.
# DATA_DIR=data

# Origins a browser may call den-edge from, comma-separated — the Den web app (another origin on the
# tailnet). Unset sends no CORS headers; the companion page at /app is same-origin and needs none.
# WEB_ORIGINS=https://pve.tailce93d3.ts.net

# Bearer token for /metrics. Unset or empty turns the route off (404).
# METRICS_TOKEN=

# Anything but empty or 0 writes one stderr line per request: `<METHOD> <route> <status> <ms>ms`. The route
# is a fixed label, so no key or sync id is ever logged.
# LOG_REQUESTS=0
