# Every variable is optional; den-edge reads the process environment only (no .env loader).

# Port to listen on (the box publishes it as 8094).
# PORT=8080

# Where the state lives: the library backups, inboxes, plugin lists and settings, one file per key. The image
# sets /data; the box mounts /var/lib/den/edge-data there.
# DATA_DIR=data

# Origins a browser may call den-edge from, comma-separated — the Den web app (another origin on the
# tailnet). Unset sends no CORS headers; the companion page at /app is same-origin and needs none.
# WEB_ORIGINS=https://box.tail0000.ts.net

# Optional Cast/media split: the Web Sender stays HTTPS, while a Chromecast on the home LAN may fetch signed HLS
# directly over HTTP. LAN_MEDIA_BASE must be RFC 1918 or a non-loopback *.local host when it uses HTTP.
# CAST_ORIGIN=https://cast.example.net
# PUBLIC_MEDIA_BASE=https://media.example.net
# LAN_MEDIA_BASE=http://192.168.1.20:8449

# Exact WEB_HOSTS names allowed to discover the profiles canary at GET /capabilities/profiles. Every name must
# also be in WEB_HOSTS. Unset or empty is off everywhere; do not add d.oxy.fi until the canary is intentionally
# activated after deploy and rollback probes are ready.
# PROFILES_HOSTS=

# Emergency transport kill for the authenticated Owner-split transaction. This alone enrolls no household and
# starts nothing. A canary needs this plus its exact id in PROFILE_PREPARE_HOUSEHOLDS; both default off.
# PROFILE_MIGRATION_ENABLED=0
# PROFILE_RESET_ENABLED=0

# Exact lowercase 32-hex household library ids allowed to prepare the one-time Owner split, comma-separated.
# Empty keeps every legacy household off. Never put tokens or profile-library ids here. A committed wire-5
# household derives runtime from its encrypted stored directory and keeps recovery transport without this entry.
# PROFILE_PREPARE_HOUSEHOLDS=

# Bearer token for /metrics. Unset or empty turns the route off (404).
# METRICS_TOKEN=

# Anything but empty or 0 writes one stderr line per request: `<METHOD> <route> <status> <ms>ms`. The route
# is a fixed label, so no key or sync id is ever logged.
# LOG_REQUESTS=0

# On by default: a playback report (/playback/outcome, /playback/cast, /playback/startup) logs what was
# played — the TMDB id, the release name and size, the chosen audio and subtitle tracks — joinable to the
# session by the request id den-edge logs anyway. Set to 0 or false to drop those fields; every other field
# (event, outcome, reason, durations, rid) is logged either way.
# LOG_IDENTITY=0
