{
  "name": "den-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Den web app: the Apple TV app's screens in a browser, served by den-edge.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/precompress.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^24.13.3",
    "svelte": "^5.46.4",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0 || ^5.0.0",
    "@playwright/test": "^1.58.2"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "hls.js": "^1.7.2"
  }
}
