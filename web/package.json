{
  "name": "den-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Den web app: the Apple TV app's screens in a browser, served by den-edge.",
  "scripts": {
    "dev": "vite",
    "dev:tv:webos": "DEN_TV_PLATFORM=webos vite --config vite.tv.config.ts",
    "dev:tv:tizen": "DEN_TV_PLATFORM=tizen vite --config vite.tv.config.ts",
    "build:tv:webos": "DEN_TV_PLATFORM=webos vite build --config vite.tv.config.ts && node scripts/verify-tv-build.mjs webos",
    "build:tv:tizen": "DEN_TV_PLATFORM=tizen vite build --config vite.tv.config.ts && node scripts/verify-tv-build.mjs tizen",
    "audit:tv:tizen3-css": "node scripts/report-tizen3-css.mjs",
    "preview:tv:webos": "DEN_TV_PLATFORM=webos vite preview --config vite.tv.config.ts",
    "preview:tv:tizen": "DEN_TV_PLATFORM=tizen vite preview --config vite.tv.config.ts",
    "package:tv": "node scripts/tv-package.mjs",
    "preflight:tv": "node scripts/tv-preflight.mjs",
    "test:tv-preflight": "node scripts/tv-preflight.integration.mjs",
    "check:tv-isolation": "node scripts/check-tv-isolation.mjs",
    "test:e2e:tv": "playwright test --config playwright.tv.config.ts",
    "test:e2e:keyboard": "playwright test --config playwright.keyboard.config.ts",
    "test:e2e:tv-soak": "DEN_TV_SOAK=1 playwright test --config playwright.tv.config.ts tv-home.spec.mjs --workers=1",
    "test:e2e:tv-package": "playwright test --config playwright.tv-package.config.ts",
    "build": "vite build && node scripts/verify-worker-build.mjs && vite build --ssr src/shell.ts --outDir dist-shell && node scripts/shell.mjs && node scripts/precompress.mjs",
    "build:cast": "vite build --config vite.cast.config.ts",
    "check:cast": "tsc --ignoreConfig --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --lib ES2022,DOM,DOM.Iterable --types vite/client cast/src/main.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:worker-build": "node scripts/test-library-service-worker.mjs",
    "test:e2e": "playwright test --grep-invert @soak",
    "test:e2e:budgets": "playwright test --config playwright.budgets.config.ts",
    "rehearse:household": "node scripts/rehearse-household.mjs",
    "rehearse:join": "node scripts/rehearse-household-join.mjs",
    "rehearse:release": "node scripts/rehearse-release.mjs",
    "test:e2e:soak": "playwright test --grep @soak",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"{src,test}/**/*.{css,svelte}\" --max-warnings 0",
    "lint": "npm run format:check && npm run lint:js && npm run lint:css && npm run check && npm run check:cast",
    "lint:js": "eslint . --max-warnings 0",
    "audit": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@csstools/css-calc": "^3.4.3",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-legacy": "8.2.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.28",
    "postcss-custom-properties": "^15.0.4",
    "postcss-html": "2.0.0",
    "postcss-logical": "^9.0.2",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.0.0",
    "terser": "5.51.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "8.71.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@juggle/resize-observer": "^3.4.0",
    "@noble/curves": "^2.4.0",
    "abortcontroller-polyfill": "^1.7.8",
    "core-js": "^3.50.0",
    "hls.js": "^1.7.3",
    "intersection-observer": "^0.12.2",
    "qrcode-generator": "2.0.4",
    "ristretto255": "^0.1.3"
  }
}
